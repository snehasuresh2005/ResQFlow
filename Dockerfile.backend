# Build stage
FROM maven:3.9.6-eclipse-temurin-17-alpine AS build
WORKDIR /app
COPY backend/pom.xml .
RUN mvn dependency:go-offline -B
COPY backend/src ./src
RUN mvn package -DskipTests -B

# Run stage
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
RUN addgroup -S resqgroup && adduser -S resquser -G resqgroup
COPY --from=build --chown=resquser:resqgroup /app/target/resqflow-1.0.0.jar resqflow.jar
USER resquser
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "resqflow.jar"]

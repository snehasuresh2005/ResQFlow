# ResQFlow Production Environment Variables Template
# Copy this file as '.env' on the EC2 host and fill in actual secure credentials.

# Application Profiles
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Production Database Container Configuration
POSTGRES_DB=resqflow
POSTGRES_USER=resqflow
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_DATABASE_PASSWORD

# Backend JDBC Connection (resolves to postgres container on resqflow-network)
DATABASE_URL=jdbc:postgresql://postgres:5432/resqflow
DATABASE_USERNAME=resqflow
DATABASE_PASSWORD=CHANGE_ME_TO_A_SECURE_DATABASE_PASSWORD

# Production Redis Configuration (resolves to redis container)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Production Kafka Configuration (resolves to kafka container internal listener)
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# JWT Authentication Config (MUST generate a secure Base64 256-bit string)
# E.g. openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET
JWT_EXPIRATION_MS=86400000

# CORS Whitelist (EC2 Public IP and/or domain name)
CORS_ALLOWED_ORIGINS=http://EC2_PUBLIC_IP:3000

# Next.js API client (Evaluated at Docker build time via --build-arg)
NEXT_PUBLIC_API_URL=http://EC2_PUBLIC_IP:8080/api/v1

# ResQFlow Environment Configuration Example

# Backend configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/resqflow
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Caching Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Event Broker Configuration (Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT Security Configuration
JWT_SECRET=dGhpcy1pcy1hLXNlY3VyZS1hbmQtc3Ryb25nLWp3dC1zZWNyZXQta2V5LXRoYXQtbXVzdC1iZS0yNTYtYml0cw==
JWT_EXPIRATION_MS=86400000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
